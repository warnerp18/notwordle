      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rate limiting login attempts\nEmail verification and password reset\nSign up reveals whether an email has an account\n   (fixed by email verification)\nSession ids are stored as-is (later: store a hash)\nLogged-in page load: fetching the current game\n   from the server (not drawn yet)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
